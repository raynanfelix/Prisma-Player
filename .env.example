# ============================================================
# Prisma Player — variáveis de ambiente (Neon + Drizzle)
# ============================================================
# Nada aqui usa prefixo NEXT_PUBLIC_ exceto NEXT_PUBLIC_SITE_URL e
# NEXT_PUBLIC_NEON_REALTIME_URL (URL pública do WebSocket de Realtime).
# O DATABASE_URL real já é provisionado na Vercel pela integração
# oficial do marketplace Neon (Project → Storage → Connect Neon).

# Neon Realtime (live queries) — 'neon env pull --service postgres --service realtime'
# NEON_REALTIME_URL e NEON_REALTIME_SECRET são secretas; só a URL é pública.
NEXT_PUBLIC_NEON_REALTIME_URL=wss://...

# Postgres (Lakebase/Neon) — POOLED para a aplicação (hostname com -pooler).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# UNPOOLED (direta, sem -pooler): SOMENTE para drizzle-kit e migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth) — painel Neon: Project → Branch → Auth.
# Auth URL COM o path completo (/neondb/auth).
# A MESMA URL serve o JWKS (/.well-known/jwks.json) que verifica a assinatura
# Ed25519 do webhook user.created — NENHUMA variável nova é necessária.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# Segredo dos cookies de sessão: openssl rand -base64 32 (mín. 32 chars).
NEON_AUTH_COOKIE_SECRET=

# Domínio base da aplicação. Use https://prismaplayer.online para o site de
# marketing ou https://app.prismaplayer.online para o app/dashboard.
# Em desenvolvimento local, mantenha http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OBRIGATORIO: Chave secreta independente para assinar tokens de embed.
EMBED_ORIGIN_SECRET=

# Vercel Cron: gere um segredo longo. A Vercel envia Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Defina como "true" SOMENTE se o Cloudflare estiver realmente na frente do deploy.
# Caso contrario, o header cf-connecting-ip e forjavel e burla o rate limiting.
TRUST_CLOUDFLARE_IP_HEADER=false

# Bloqueio de VPN/proxy (sub-aba "Bloco Geográfico" do studio): proxycheck.io.
# SEM esta chave a checagem e inerte (fail-open) e ninguem e bloqueado.
# Crie sua chave em https://proxycheck.io e configure-a na Vercel.
VPN_DETECTION_KEY=

# E-mails do aplicativo (reports; auth usa o SMTP do Neon Auth).
RESEND_API_KEY=
REPORT_EMAIL_FROM="Prisma Player <relatorios@seudominio.com>"

# Eventos server-side de anúncios. JSON indexado pelo ID público do pixel.
# Mantenha estes tokens somente no backend/Vercel; nunca use NEXT_PUBLIC_.
META_CAPI_TOKENS_JSON={}
# Versão Graph aprovada para sua conta, por exemplo v23.0.
META_GRAPH_API_VERSION=v23.0
TIKTOK_EVENTS_TOKENS_JSON={}
# Opcional; mantenha vazio para usar o endpoint oficial padrão.
TIKTOK_EVENTS_API_URL=

# NVIDIA API Catalog / NIM: somente backend. A chave nunca chega ao navegador.
NVIDIA_API_KEY=
NVIDIA_AI_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_AI_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Cloudflare R2 (somente backend). Crie um token limitado ao bucket de videos.
CLOUDFLARE_R2_ACCOUNT_ID=
# Opcional: use apenas se o bucket exigir endpoint jurisdicional (ex.: UE).
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=prisma-videos
# Limite por arquivo em bytes. Padrao da aplicacao: 20 GiB.
R2_MAX_UPLOAD_BYTES=21474836480

# ============================================================
# Fase 1 — System Design Scale (cache de borda / Cloudflare)
# ============================================================
# Endpoint POST /__purge deployado no Worker prisma-embed-cache.
# A Vercel chama quando um player_config e atualizado.
CLOUDFLARE_PURGE_URL=
# Deve ser identico SHARED_PURGE_SECRET provisionado no Worker (wrangler secret put).
CLOUDFLARE_PURGE_SECRET=

# Retenção de dados (dias; 0/vazio = desligado). Sem env, o cron só faz
# rollup (insert-only) e nunca apaga. Ex.: VIDEO_EVENTS_RETENTION_DAYS=400.
#VIDEO_EVENTS_RETENTION_DAYS=
#PLAYER_EVENTS_RETENTION_DAYS=
#SECURITY_EVENTS_RETENTION_DAYS=
#WEBHOOK_PAYLOAD_RETENTION_DAYS=

# Rate-limit por minuto no /api/embed/:id e /api/embed/:id/manifest.
# Use apenas dígitos: "60_000" NAO e um numero valido para Number() em JS.
EMBED_CONFIG_RATE_LIMIT_MAX=300
EMBED_CONFIG_RATE_LIMIT_WINDOW_MS=60000
EMBED_MANIFEST_RATE_LIMIT_MAX=600
EMBED_MANIFEST_RATE_LIMIT_WINDOW_MS=60000
# Rota POST /api/embed/:id/session (toggle DRM "sessao assinada"): mint do
# sessionToken — crypto puro, sem banco; rate-limit por IP por player.
EMBED_SESSION_RATE_LIMIT_MAX=60
EMBED_SESSION_RATE_LIMIT_WINDOW_MS=60000

# ============================================================
# Limites de plano (fallback quando a assinatura nao define)
# ============================================================
# Armazenamento liberado durante o trial, em GB.
TRIAL_STORAGE_GB=5

# ============================================================
# Stripe (Opção A — Checkout hospedado)
# ============================================================
# API key do servidor. USE UMA RESTRICTED API KEY (prefixo rk_),
# nunca uma secret key sk_ — e nunca em código. Permissões mínimas:
# products/prices (R+W), checkout sessions, billing portal sessions,
# subscriptions/invoices (R), webhooks.
# Gere em Dashboard → Developers → API keys → Create restricted key.
STRIPE_SECRET_KEY=
# Signing secret do endpoint de webhook (Developers → Webhooks →
# SEU endpoint → Signing secret, prefixo whsec_). O handler em
# src/app/api/webhooks/stripe valida TODA entrega com ele.
STRIPE_WEBHOOK_SECRET=
# NOTA DE TAX: automatic_tax permanece DESLIGADO no código — o
# Stripe Tax não cobre o Brasil hoje; impostos (ISS/IOF…) ficam
# embutidos no preço, como o pricing público já comunica.

# ============================================================
# Alerta operacional (hardening pós-audit, item 5)
# ============================================================
# Canal PRIVADO do dono para falhas de produção (webhook Stripe com
# evento failed, webhook Neon Auth rejeitado, checkout/portal fora do
# ar, disputa/estorno/aviso de fraude). Cole aqui o webhook do seu
# servidor privado do Discord (Canal → Editar → Integrations →
# Webhooks → Copy Webhook URL). Telegram direto nao aceita o payload
# { content } — use um relay/bridge ou o webhook do Discord.
# Sem esta variável o alerta é inerte (nenhuma chamada, nenhum erro).
# Somente HTTPS; o texto do alerta nunca inclui token/segredo.
ALERT_WEBHOOK_URL=
